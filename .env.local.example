# Frontend environment. Copy to .env.local for local development.
#
# Base URL of the API in ./server. The contact form posts to
# <NEXT_PUBLIC_API_URL>/api/contact. Because the site is a static export this
# value is inlined at build time, so changing it requires a rebuild.
#
# Local:      http://localhost:4000
# Production: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000
