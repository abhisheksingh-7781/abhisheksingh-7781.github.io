# Build-time config for the deployed site (read by `next build`).
#
# The site is a static export, so this URL is inlined into the JavaScript at
# build time — it is public by design, not a secret, and belongs in git.
#
# To point the contact form at a different API, edit this line and push; the
# Pages workflow rebuilds and the new URL ships with it.
NEXT_PUBLIC_API_URL=https://abhisheksingh-7781-github-io.vercel.app
