# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is required to boot: with no SMTP and
# no MongoDB the API runs but refuses submissions with a 503, rather than
# accepting messages it has nowhere to put.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Browser origins allowed to call this API, comma separated.
# Add the deployed site here, e.g. https://abhisheksingh-7781.github.io
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Set to 1 when deployed behind a platform proxy (Render, Railway, Fly, Nginx).
# Leave 0 locally, or rate limiting will key off a spoofable header.
TRUST_PROXY=0

# --- Contact form throttle ---
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15

# --- Storage (optional) ---
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio

# --- Email delivery (optional) ---
# For Gmail, use an App Password, not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# CONTACT_TO_EMAIL=abhisheksingh5208@gmail.com
# CONTACT_FROM_EMAIL=you@gmail.com

# --- Admin read endpoint (optional) ---
# At least 24 characters. Omit and /api/contact/messages returns 404.
# ADMIN_API_KEY=
